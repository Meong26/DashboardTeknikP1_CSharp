@{
    ViewData["Title"] = "Terjadi Kesalahan";
    Layout = "_Layout";
}

<div class="container-fluid d-flex flex-column justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="text-center">
        <i class="bi bi-exclamation-triangle text-danger" style="font-size: 5rem;"></i>
        <h1 class="display-5 fw-bold mt-3 text-body-emphasis">Oops! Terjadi Kesalahan</h1>
        <p class="lead text-muted mt-3 mb-5" style="max-width: 600px; margin: 0 auto;">
            Sistem kami sedang mengalami gangguan internal atau mencoba memproses data yang tidak valid. 
            Mohon maaf atas ketidaknyamanan ini. Tim IT sedang diberitahu untuk menangani masalah ini.
        </p>
        
        <div class="d-flex justify-content-center gap-3">
            <a href="/" class="btn btn-primary px-4 py-2 fw-semibold shadow-sm">
                <i class="bi bi-house-door me-2"></i> Kembali ke Beranda
            </a>
            <button onclick="window.history.back()" class="btn btn-outline-secondary px-4 py-2 fw-semibold">
                <i class="bi bi-arrow-left me-2"></i> Halaman Sebelumnya
            </button>
        </div>
    </div>
</div>
