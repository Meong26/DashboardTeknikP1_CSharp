@{
    ViewData["Title"] = "HMI Live Monitoring";
}

<div class="container-fluid p-0">
    <!-- Header Control Bar -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <!-- Left: Title & Dropdown Switcher -->
                <div class="d-flex align-items-center gap-3">
                    <h5 class="m-0 fw-bold text-body-emphasis d-flex align-items-center">
                        <i class="bi bi-display text-primary me-2 fs-4"></i> HMI Live Monitoring
                    </h5>

                    <!-- Dropdown Pemilihan HMI (Dapat ditambah HMI baru secara dinamis) -->
                    <div class="dropdown">
                        <button class="btn btn-primary dropdown-toggle fw-bold py-1 px-3 d-flex align-items-center shadow-sm" type="button" id="hmiDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-cpu me-2"></i>
                            <span id="selectedHmiTitle">Counter FG</span>
                        </button>
                        <ul class="dropdown-menu shadow-lg border-0 mt-1" aria-labelledby="hmiDropdownBtn" style="min-width: 220px;" id="hmiDropdownList">
                            <li>
                                <a class="dropdown-item py-2 fw-semibold active d-flex justify-content-between align-items-center" href="javascript:void(0)" 
                                   data-title="Counter FG" data-url="http://10.124.8.10" data-ip="10.124.8.10" onclick="selectHmiOption(this)">
                                    <span>Counter FG</span>
                                    <span class="badge bg-light text-dark font-monospace small border">10.124.8.10</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 fw-semibold d-flex justify-content-between align-items-center" href="javascript:void(0)" 
                                   data-title="Mixer Monitoring" data-url="http://10.124.8.30" data-ip="10.124.8.30" onclick="selectHmiOption(this)">
                                    <span>Mixer Monitoring</span>
                                    <span class="badge bg-light text-dark font-monospace small border">10.124.8.30</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Right: Status Badge & Action Controls -->
                <div class="d-flex align-items-center gap-2">
                    @if (User.IsInRole("Administrator") || User.IsInRole("Supervisor Teknik") || User.IsInRole("Section Teknik"))
                    {
                        <a href="/Hmi/Logs" class="btn btn-sm btn-outline-info fw-semibold">
                            <i class="bi bi-journal-text me-1"></i> Lihat Log
                        </a>
                    }
                    <div id="hmiStatusBadge" class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle px-3 py-2 font-monospace small">
                        <i class="bi bi-arrow-repeat me-1 spinner-border spinner-border-sm"></i> Memeriksa 10.124.8.10...
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- HMI Launcher Pad -->
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="card shadow-lg border-0 bg-body-tertiary" style="border-radius: 15px; overflow: hidden;">
                
                <!-- Accent Line -->
                <div class="bg-primary w-100" style="height: 5px;"></div>
                
                <div class="card-body p-5 text-center">
                    <!-- Icon / Illustration -->
                    <div class="mb-4 d-inline-flex justify-content-center align-items-center bg-primary-subtle text-primary rounded-circle" style="width: 120px; height: 120px; box-shadow: 0 10px 20px rgba(0,123,255,0.15);">
                        <i class="bi bi-window-desktop" style="font-size: 3.5rem;"></i>
                    </div>

                    <!-- Title -->
                    <h3 class="fw-bolder text-body-emphasis mb-2" id="launcherTitle">Counter FG</h3>
                    <p class="text-secondary mb-4 fs-5 font-monospace" id="launcherIp">
                        <i class="bi bi-link-45deg me-1"></i> http://10.124.8.10
                    </p>

                    <hr class="w-50 mx-auto text-muted opacity-25 mb-4">

                    <!-- Description -->
                    <p class="text-muted mb-5">
                        Menghubungkan HMI secara langsung ke jendela baru.
                    </p>

                    <!-- Launch Action -->
                    <button class="btn btn-primary btn-lg px-5 py-3 fw-bold rounded-pill shadow-sm hover-elevate transition-all" onclick="launchHmi()" id="btnLaunch">
                        <i class="bi bi-rocket-takeoff fs-5 me-2"></i> Luncurkan Layar HMI
                    </button>
                    
                    <div class="mt-4">
                        <small class="text-muted"><i class="bi bi-info-circle me-1"></i> Pastikan browser Anda mengizinkan Popup untuk situs ini.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-elevate:hover {
        transform: translateY(-3px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
    .transition-all {
        transition: all 0.3s ease;
    }
</style>

<script>
    let activeTitle = "Counter FG";
    let activeUrl = "http://10.124.8.10";
    let activeIp = "10.124.8.10";

    function selectHmiOption(element) {
        document.querySelectorAll('#hmiDropdownList .dropdown-item').forEach(item => item.classList.remove('active'));
        element.classList.add('active');

        activeTitle = element.getAttribute('data-title');
        activeUrl = element.getAttribute('data-url');
        activeIp = element.getAttribute('data-ip');

        // Update Dropdown Title
        document.getElementById('selectedHmiTitle').innerText = activeTitle;

        // Update Launcher Area
        document.getElementById('launcherTitle').innerText = activeTitle;
        document.getElementById('launcherIp').innerHTML = `<i class="bi bi-link-45deg me-1"></i> ${activeUrl}`;
        
        // Add subtle animation to button
        const btn = document.getElementById('btnLaunch');
        btn.classList.add('btn-outline-primary');
        btn.classList.remove('btn-primary');
        setTimeout(() => {
            btn.classList.add('btn-primary');
            btn.classList.remove('btn-outline-primary');
        }, 300);

        checkHmiPing(activeIp);
    }

    async function launchHmi() {
        // Log Access ke Server
        try {
            let formData = new FormData();
            formData.append("ip", activeIp);
            formData.append("hmiName", activeTitle);
            await fetch('/Hmi/LogAccess', { method: 'POST', body: formData });
        } catch (e) {
            console.error("Gagal mencatat log", e);
        }

        // Feature detect modern options for a cleaner window (app-like feel)
        const windowFeatures = "location=no,toolbar=no,menubar=no,scrollbars=yes,resizable=yes,width=1280,height=720,top=100,left=100";
        
        // Open the HMI in a new native window or tab
        const hmiWindow = window.open(activeUrl, `HMI_${activeIp.replace(/\./g, '_')}`, windowFeatures);
        
        if (!hmiWindow || hmiWindow.closed || typeof hmiWindow.closed == 'undefined') {
            alert("Perhatian: Browser Anda memblokir Popup. Silakan izinkan Popup (Popup Blocker) di address bar untuk situs ini.");
        }
    }

    async function checkHmiPing(ip) {
        const badge = document.getElementById('hmiStatusBadge');
        badge.className = "badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle px-3 py-2 font-monospace small";
        badge.innerHTML = `<i class="bi bi-arrow-repeat me-1 spinner-border spinner-border-sm"></i> Memeriksa ${ip}...`;

        try {
            const response = await fetch(`/Hmi/CheckStatus?ip=${ip}`);
            if (response.ok) {
                const data = await response.json();
                if (data.online) {
                    badge.className = "badge bg-success-subtle text-success-emphasis border border-success-subtle px-3 py-2 font-monospace small";
                    badge.innerHTML = `<i class="bi bi-circle-fill text-success-emphasis me-1" style="font-size: 0.6rem;"></i> ${ip} ONLINE (${data.latencyMs} ms)`;
                } else {
                    badge.className = "badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 font-monospace small";
                    badge.innerHTML = `<i class="bi bi-exclamation-triangle-fill text-warning-emphasis me-1"></i> ${ip} OFFLINE / MTO`;
                }
            }
        } catch (e) {
            badge.className = "badge bg-danger-subtle text-danger-emphasis border border-danger-subtle px-3 py-2 font-monospace small";
            badge.innerHTML = `<i class="bi bi-hdd-network me-1"></i> ${ip} GAGAL PING`;
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        checkHmiPing(activeIp);
    });
</script>
